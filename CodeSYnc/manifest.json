{
  "manifest_version": 3,
  "name": "CodeSync",
  "version": "0.1.0",
  "description": "Sync your Codeforces submissions.",
  "icons": {
    "16": "img16.png",
    "48": "img48.png",
    "128": "img128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img16.png",
      "48": "img48.png",
      "128": "img128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}